{
  "files": { "big.ts": 400, "small.ts": 40, "edge.ts": 350 },
  "agents": { "scout": "haiku", "planner": "inherit", "fe-engineer": "sonnet" },
  "cases": [
    { "hook": "read", "name": "whole read of big file", "input": { "tool_name": "Read", "tool_input": { "file_path": "big.ts" } }, "want": "deny" },
    { "hook": "read", "name": "absolute path", "input": { "tool_name": "Read", "tool_input": { "file_path": "$DIR/big.ts" } }, "want": "deny" },
    { "hook": "read", "name": "targeted read with offset", "input": { "tool_name": "Read", "tool_input": { "file_path": "big.ts", "offset": 100, "limit": 40 } }, "want": "allow" },
    { "hook": "read", "name": "limit only", "input": { "tool_name": "Read", "tool_input": { "file_path": "big.ts", "limit": 50 } }, "want": "allow" },
    { "hook": "read", "name": "small file", "input": { "tool_name": "Read", "tool_input": { "file_path": "small.ts" } }, "want": "allow" },
    { "hook": "read", "name": "exactly the threshold", "input": { "tool_name": "Read", "tool_input": { "file_path": "edge.ts" } }, "want": "allow" },
    { "hook": "read", "name": "subagent reads big file", "input": { "agent_id": "a1", "agent_type": "scout", "tool_name": "Read", "tool_input": { "file_path": "big.ts" } }, "want": "allow" },
    { "hook": "read", "name": "--agent planner main session is still guarded", "input": { "agent_type": "planner", "tool_name": "Read", "tool_input": { "file_path": "big.ts" } }, "want": "deny" },
    { "hook": "read", "name": "missing file", "input": { "tool_name": "Read", "tool_input": { "file_path": "nope.ts" } }, "want": "allow" },
    { "hook": "read", "name": "image", "input": { "tool_name": "Read", "tool_input": { "file_path": "shot.png" } }, "want": "allow" },
    { "hook": "read", "name": "cat big file", "input": { "tool_name": "Bash", "tool_input": { "command": "cat big.ts" } }, "want": "deny" },
    { "hook": "read", "name": "cat after cd", "input": { "tool_name": "Bash", "tool_input": { "command": "git status && cat -n big.ts" } }, "want": "deny" },
    { "hook": "read", "name": "cat piped to grep", "input": { "tool_name": "Bash", "tool_input": { "command": "cat big.ts | grep export" } }, "want": "allow" },
    { "hook": "read", "name": "head of big file", "input": { "tool_name": "Bash", "tool_input": { "command": "head -50 big.ts" } }, "want": "allow" },
    { "hook": "read", "name": "sed range of big file", "input": { "tool_name": "Bash", "tool_input": { "command": "sed -n 100,140p big.ts" } }, "want": "allow" },
    { "hook": "read", "name": "cat small file", "input": { "tool_name": "Bash", "tool_input": { "command": "cat small.ts" } }, "want": "allow" },
    { "hook": "read", "name": "less big file", "input": { "tool_name": "Bash", "tool_input": { "command": "less big.ts" } }, "want": "deny" },
    { "hook": "read", "name": "unparseable command", "input": { "tool_name": "Bash", "tool_input": { "command": "cat 'big.ts" } }, "want": "allow" },
    { "hook": "read", "name": "guard off", "env": { "AI_TOOLBOX_READ_GUARD": "off" }, "input": { "tool_name": "Read", "tool_input": { "file_path": "big.ts" } }, "want": "allow" },
    { "hook": "read", "name": "lower threshold", "env": { "AI_TOOLBOX_READ_LINES": "20" }, "input": { "tool_name": "Read", "tool_input": { "file_path": "small.ts" } }, "want": "deny" },
    { "hook": "read", "name": "malformed input fails open", "raw": "not json", "want": "allow" },
    { "hook": "spawn", "name": "general-purpose without model", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "general-purpose", "prompt": "x" } }, "want": "deny" },
    { "hook": "spawn", "name": "no subagent_type, no model", "input": { "tool_name": "Agent", "tool_input": { "prompt": "x" } }, "want": "deny" },
    { "hook": "spawn", "name": "Explore without model", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "Explore", "prompt": "x" } }, "want": "deny" },
    { "hook": "spawn", "name": "general-purpose on haiku", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "general-purpose", "model": "haiku" } }, "want": "allow" },
    { "hook": "spawn", "name": "pinned scout", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "scout" } }, "want": "allow" },
    { "hook": "spawn", "name": "pinned persona", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "fe-engineer" } }, "want": "allow" },
    { "hook": "spawn", "name": "agent that inherits", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "planner" } }, "want": "deny" },
    { "hook": "spawn", "name": "explicit opus asks", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "general-purpose", "model": "opus" } }, "want": "ask" },
    { "hook": "spawn", "name": "explicit fable asks", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "general-purpose", "model": "fable" } }, "want": "ask" },
    { "hook": "spawn", "name": "pinned type, model overridden to sonnet", "input": { "tool_name": "Agent", "tool_input": { "subagent_type": "planner", "model": "sonnet" } }, "want": "allow" },
    { "hook": "spawn", "name": "guard off", "env": { "AI_TOOLBOX_SPAWN_GUARD": "off" }, "input": { "tool_name": "Agent", "tool_input": { "prompt": "x" } }, "want": "allow" }
  ]
}
