{
  "description": "ai-toolbox guards: safe helper commands, large-file reads, and subagent model tiers",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/read_guard.py\"", "timeout": 10 }]
      },
      {
        "matcher": "Agent",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/spawn_guard.py\"", "timeout": 10 }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent_guard.py\"", "timeout": 10 }]
      }
    ]
  }
}
